# ==============================================================================
# Central Hive Configuration (deployments/hive/.env)
# Copy this file to deployments/hive/.env and replace all placeholder values.
# ==============================================================================

# PostgreSQL 17 & Redis 7 (bound strictly to 127.0.0.1 loopback)
POSTGRES_USER=honeypot
POSTGRES_PASSWORD=change_me_to_random_32_char_password
POSTGRES_DB=honeypot
HIVE_PG_PORT=15432
HIVE_REDIS_PORT=16379

# Hive Control Plane & mTLS Ingress
# Admin console refuses non-loopback/non-VPN addresses unless --unsafe-dev-bind is passed.
HIVE_ADMIN_BIND_ADDR=127.0.0.1:8443
HIVE_ADMIN_IFACE=
ADMIN_ALLOWED_CIDRS=127.0.0.0/8,::1/128,100.64.0.0/10,fc00::/7
HIVE_INGRESS_ADDR=:9443
# Comma-separated SANs embedded in the Hive mTLS ingress certificate
HIVE_INGRESS_SANS=127.0.0.1,localhost,hive.example.com,enroll.hive.internal
HIVE_PUBLIC_INGRESS=hive.example.com:9443

# Persistent 32-byte secret for HMAC-SHA256 Canary Key generation/verification
# Generate with: openssl rand -hex 32
HIVE_CANARY_MASTER_KEY=

# Chameleon LLM Deception Relay (keys remain on Hive only; set HIVE_LLM_MAX_DAILY_USD=0 for $0 tarpit mode)
HIVE_LLM_MAX_DAILY_USD=0
HIVE_UPSTREAM_LLM_URL=
HIVE_UPSTREAM_LLM_KEY=
HIVE_UPSTREAM_LLM_MODEL=deepseek-chat

# Active Guard: Cloudflare Custom IP Lists (optional)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_LIST_ID=
CLOUDFLARE_ENTERPRISE_JA4_ENABLED=false

# Threat Intelligence Enrichment (optional)
HIVE_GEOIP_CITY_MMDB=
HIVE_GEOIP_ASN_MMDB=
GREYNOISE_API_KEY=
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# Alerting Dispatchers (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
ALERT_WEBHOOK_URL=

# ==============================================================================
# Edge Sensor Installer Variables (used by scripts/install-sensor.sh)
# ==============================================================================
# HIVE_ADDR=hive.example.com:9443
# HIVE_SNI=hive.internal
# ENROLL_SNI=enroll.hive.internal
# ENROLL_TOKEN=hpj_replace_with_one_time_token
# CA_FINGERPRINT=replace_with_64_char_sha256_root_ca_fingerprint
# PUBLIC_IPV4=203.0.113.10
# AI_GATEWAY_URL=https://203.0.113.10
