FROM golang:1.27-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/docker-guard-proxy ./cmd/docker-guard-proxy
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/docker-guard-proxy ./cmd/docker-guard-proxy

FROM scratch
COPY --from=builder /out/docker-guard-proxy /docker-guard-proxy
USER 65532:65532
ENTRYPOINT ["/docker-guard-proxy"]
